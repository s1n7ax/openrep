{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/s1n7ax/openrep/main/data/schema/animation.v1.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "exerciseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case identifier, e.g. \"barbell-bench-press-medium-grip\"."
    },
    "durationSec": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 60,
      "description": "Length of one repetition (one loop), in seconds."
    },
    "camera": {
      "description": "Initial camera; default is a 3/4 front view.",
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z] in metres."
        },
        "target": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "[x, y, z] in metres."
        }
      },
      "required": [
        "position",
        "target"
      ],
      "additionalProperties": false
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "barbell",
              "ez-bar",
              "dumbbell",
              "kettlebell",
              "bench",
              "incline-bench",
              "cable-handle",
              "rope-handle",
              "lat-bar",
              "pull-up-bar",
              "dip-bars",
              "leg-press",
              "leg-extension",
              "leg-curl",
              "mat"
            ]
          },
          "attach": {
            "type": "string",
            "enum": [
              "none",
              "hands",
              "leftHand",
              "rightHand",
              "feet",
              "leftFoot",
              "rightFoot"
            ],
            "description": "\"none\" places the prop in the world; otherwise it follows the hand(s) or foot/feet. \"hands\"/\"feet\" centre the prop between both hands/feet."
          },
          "position": {
            "description": "World position (attach \"none\") or offset from the attachment point.",
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3,
            "description": "Euler angles [x, y, z] in degrees, applied in X, Y, Z order."
          },
          "cableFrom": {
            "description": "World point a cable is drawn from to this prop (cable machines).",
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
