            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "expert"
            ]
          },
          "days": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "exercises": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "exerciseId": {
                        "description": "Id of an exercise in the catalog.",
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                      },
                      "name": {
                        "description": "Exercise name; required when there is no exerciseId.",
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "sets": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      "reps": {
                        "type": "string",
                        "pattern": "^[1-9]\\d{0,2}(-[1-9]\\d{0,2})?$",
                        "description": "A number (\"8\") or an ascending range (\"8-12\")."
                      },
                      "durationSec": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3600
                      },
                      "restSec": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3600
                      },
                      "notes": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sets"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "exercises"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "formatVersion",
          "id",
          "name",
          "description",
          "days"
        ],
        "additionalProperties": false,
        "title": "OpenRep schedule (v1)",
        "description": "A workout schedule: data/schedules/<id>.json. Each entry sets exerciseId and/or name, and exactly one of reps or durationSec. Also checked by `npm run validate:data`: the file name equals the id and every exerciseId exists in the catalog."
      }
    }
  },
  "required": [
    "formatVersion",
    "revision",
    "generatedAt",
    "exercises",
    "animations",
    "schedules"
  ],
  "additionalProperties": false,
  "title": "OpenRep catalog (v1)",
  "description": "Every exercise, animation and schedule of the repository in one file, built by `npm run build:catalog`. Image paths are relative to the catalog file."
}
